# Generated per checkout by make bootstrap. Never store staging credentials here.
COMPOSE_PROJECT_NAME=exhibit_main
WEB_PORT=5173
API_PORT=8080
DB_PORT=5432
POSTGRES_USER=exhibit
POSTGRES_PASSWORD=exhibit_local_only
POSTGRES_DB=exhibit
DATABASE_URL=postgres://exhibit:exhibit_local_only@127.0.0.1:5432/exhibit?sslmode=disable
# Demo uses labelled sample records. postgres reads the real database.
EXHIBIT_STORE=demo
# Local HTTP only. Production PostgreSQL defaults to secure session cookies.
EXHIBIT_COOKIE_SECURE=false
