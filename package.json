{
  "name": "exhibit",
  "version": "0.1.0",
  "private": true,
  "description": "Review the evidence. Ship with confidence.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @exhibit/web",
    "typecheck": "npm run typecheck --workspace @exhibit/web",
    "contracts:generate": "npm run generate --workspace @exhibit/contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check": "npm run contracts:generate && npm run typecheck && npm run build && npm run format:check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
